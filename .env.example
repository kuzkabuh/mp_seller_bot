BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE
# Генерируйте этот ключ командой: openssl rand -base64 32
FERNET_KEY=PUT_YOUR_FERNET_KEY_HERE

# Параметры PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=mp_seller_bot
POSTGRES_USER=mpbot
POSTGRES_PASSWORD=mpbot_password

# Интервал опроса (сек) для фонового воркера
POLL_INTERVAL_SECONDS=60

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Настройки вебхука. Если USE_WEBHOOK=true, приложение будет запускаться
# через aiohttp и слушать входящие сообщения на указанном хосте и порту.
# BASE_WEBHOOK_URL — публичный URL, который Telegram будет использовать
# для отправки обновлений. WEBHOOK_SECRET — секретный токен для
# проверки запросов.
USE_WEBHOOK=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_PATH=/webhook
BASE_WEBHOOK_URL=https://example.com
WEBHOOK_SECRET=your-secret-token