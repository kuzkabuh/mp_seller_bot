# Версия файла: 1.0.0
# Описание: Пример конфигурации окружения для mp_seller_bot
# Дата изменения: 2025-12-27

# --- Telegram ---
TELEGRAM_BOT_TOKEN=put_your_token_here

# --- PostgreSQL (контейнер db в docker-compose) ---
POSTGRES_DB=mp_seller_bot
POSTGRES_USER=mp_seller_bot
POSTGRES_PASSWORD=mp_seller_bot
POSTGRES_PORT=5432

# --- Приложение ---
# ВАЖНО: для бота используется asyncpg-драйвер.
DATABASE_URL=postgresql+asyncpg://mp_seller_bot:mp_seller_bot@db:5432/mp_seller_bot
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# Интервал (сек.) опроса новых заказов у маркетплейсов
ORDERS_POLL_INTERVAL_SECONDS=60

# Ежедневная сводка (если включена в настройках уведомлений) — время (часы/минуты) по таймзоне TIMEZONE
DAILY_SUMMARY_HOUR=9
DAILY_SUMMARY_MINUTE=0
